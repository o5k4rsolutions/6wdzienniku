{
  "version": 2,
  "routes": [
    {
      "src": "/api/stripe-webhook",
      "dest": "/api/stripe-webhook.js"
    },
    {
      "src": "/produkty/([^/]+)/([^/]+)",
      "dest": "/produkty/produkt-template.html"
    },
    {
      "src": "/mojekonto",
      "dest": "/mojekonto/index.html"
    },
    {
      "src": "/admin",
      "dest": "/admin/index.html"
    },
    {
      "src": "/api-login",
      "dest": "/api-login/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
